    { value: 'purple', label: 'å…¸é›…ç´«' },
    { value: 'cyan', label: 'æ¹–æ°´é’' },
    { value: 'rose', label: 'ç«ç‘°çº¢' }
  ];

  private updateLogs: string[] = [
    'æ¶æ„é‡å†™ï¼šå®Œå…¨é‡å†™äº†åº”ç”¨æ¶æ„ï¼Œé‡‡ç”¨å¤šé¡µé¢å¤šç»„ä»¶æ¨¡å—åŒ–æ„å»º',
    'æ²‰æµ¸å…‰æ„Ÿï¼šé›†æˆæ²‰æµ¸å¼è§†è§‰æ•ˆæœ',
