                                        Text.fontWeight(tool.url === this.currentUrl ? FontWeight.Medium : FontWeight.Regular);
                                    }, Text);
                                    Text.pop();
                                    this.observeComponentCreation2((elmtId, isInitialRender) => {
                                        Blank.create();
