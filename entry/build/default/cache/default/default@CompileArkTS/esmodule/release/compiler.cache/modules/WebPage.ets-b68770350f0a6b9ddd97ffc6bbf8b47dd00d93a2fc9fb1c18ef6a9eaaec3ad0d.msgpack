                                this.forEachUpdateFunction(elmtId, category.tools, forEachItemGenFunction, (tool) => tool.id, false, false);
                            }, ForEach);
                            // Tools in category
                            ForEach.pop();
                        };
                        this.forEachUpdateFunction(elmtId, this.dropdownCategories, forEachItemGenFunction, (category) => category.name, false, false);
                    }, ForEach);
                    ForEach.pop();
                    Column.pop();
