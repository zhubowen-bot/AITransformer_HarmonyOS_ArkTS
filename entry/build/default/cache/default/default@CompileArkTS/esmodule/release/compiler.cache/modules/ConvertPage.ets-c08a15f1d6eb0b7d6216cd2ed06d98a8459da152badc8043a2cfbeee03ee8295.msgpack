    updateStatusBarColor() {
        let appTheme = AppStorage.get('appTheme') || 'system';
        let currentMode = ThemeHelper.getEffectiveColorMode();
        let isDark = ThemeHelper.isEffectiveDarkMode(appTheme, currentMode);
        let ctx = getContext(this);
        ThemeHelper.setStatusBarColor(ctx, isDark ? '#FF1E293B' : '#FFFFFFFF');
    }
    updateDateTime() {
        let now = new Date();
        let year = now.getFullYear();
        let month = ('0' + (now.getMonth() + 1)).slice(-2);
        let day = ('0' + now.getDate()).slice(-2);
        let hours = ('0' + now.getHours()).slice(-2);
        let minutes = ('0' + now.getMinutes()).slice(-2);
