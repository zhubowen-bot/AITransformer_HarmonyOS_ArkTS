            // Confirm button
            Button.type(ButtonType.Capsule);
            // Confirm button
            Button.margin({ top: 4, bottom: 8 });
            // Confirm button
            Button.onClick(() => {
                if (this.isChecked) {
                    this.saveDismissPreference();
                }
